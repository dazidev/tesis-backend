generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  lawyer
  client
}

enum UserStatus {
  active
  inactive
  suspended
}

model User {
  id                 String            @default(uuid()) @id
  name               String
  lastname           String
  email              String            @unique
  password           String
  roles              UserRole[]
  status             UserStatus        @default(active)

  lawyers            User[]           @relation("ClientLawyers")
  clients            User[]           @relation("ClientLawyers")

  createdAt          DateTime          @default(now()) @db.Timestamptz()
  updatedAt          DateTime          @updatedAt @db.Timestamptz()

  userSessions       UserSession[]
  userInvitations    UserInvitation[]

  logsAsUser         Log[]            @relation("LogUser")
  logsAsAffectedUser Log[]            @relation("LogAffectedUser")
  processPlaintiff   Process[]        @relation("Plaintiff")
  processesManaged   Process[]        @relation("ManagedBy")
  processesCreated   Process[]        @relation("CreatedBy")

  @@index([roles])
  @@map("users")
}

model UserSession {
  id            String     @default(uuid()) @id
  refreshToken  String
  expiresAt     DateTime   @db.Timestamptz()
  isRevoked     Boolean    @default(false)
  revokedAt     DateTime?  @db.Timestamptz()
  revokedReason String?
  deviceId      String
  deviceInfo    String
  ipAddress     String
  createdAt     DateTime   @default(now()) @db.Timestamptz()
  updatedAt     DateTime   @updatedAt @db.Timestamptz()
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([refreshToken])
  @@index([userId, isRevoked])
  @@index([userId, id])
  @@index([isRevoked, expiresAt])
  @@map("user_sessions")
}

model UserInvitation {
  id          String     @default(uuid()) @id
  token       String     @unique
  toEmail     String
  role        UserRole
  expiresAt   DateTime   @db.Timestamptz()
  isUsed      Boolean    @default(false)
  usedAt      DateTime?  @db.Timestamptz()
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now()) @db.Timestamptz()
  updatedAt   DateTime   @updatedAt @db.Timestamptz()

  @@index([toEmail])
  @@map("user_invitations")
}

model Log {
  id             String    @default(uuid()) @id
  userId         String?
  user           User?    @relation("LogUser" , fields: [userId], references: [id], onDelete: SetNull)
  affectedUserId String?
  affectedUser   User?    @relation("LogAffectedUser", fields: [affectedUserId], references: [id], onDelete: SetNull)
  action         String
  description    String
  createdAt      DateTime  @default(now()) @db.Timestamptz()

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("server_log")
}

enum ProcessType {
  testate
  intestate
  mixed
}

model Defendant {
  id        String    @default(uuid()) @id
  name      String
  lastname  String
  birthDate DateTime
  deathDate DateTime
  createdAt DateTime  @default(now()) @db.Timestamptz()
  process   Process?

  @@index([id])
  @@map("defendants")
}

enum ProcessStatus {
  created
  opened
  closed
  deleted
}

model Process {
  id             String          @default(uuid()) @id
  courtNumber    String
  caseFileNumber String
  type           ProcessType
  status         ProcessStatus
  plaintiffs     User[]         @relation("Plaintiff")
  defendantId    String          @unique
  defendant      Defendant      @relation(fields: [defendantId], references: [id], onDelete: Cascade)
  managedByID    String
  managedBy      User           @relation("ManagedBy", fields: [managedByID], references: [id])

  createdById    String
  createdBy      User           @relation("CreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime        @default(now()) @db.Timestamptz()
  updatedAt      DateTime        @updatedAt @db.Timestamptz()

  stages         ProcessStage[]

  @@index([courtNumber])
  @@index([caseFileNumber])
  @@index([type])
  @@map("processes")
}

enum StageStatus {
  created
  opened
  closed
}

model ProcessStage {
  id                String             @default(uuid()) @id
  name              String
  description       String
  status            StageStatus
  processId         String
  process           Process           @relation(fields: [processId], references: [id])

  updatedAt         DateTime           @updatedAt @db.Timestamptz()
  childrenSubstages ProcessSubstage[]

  @@map("process_stages")
}

enum SubstageStatus {
  opened
  closed
  deleted
}

model ProcessSubstage {
  id                String             @default(uuid()) @id
  name              String
  description       String
  status            SubstageStatus

  stageId           String
  stage             ProcessStage      @relation( fields: [stageId],references: [id])

  parentSubstageId  String?
  parentSubstage    ProcessSubstage?  @relation("SubstageHierarchy",fields: [parentSubstageId],references: [id])

  childrenSubstages ProcessSubstage[] @relation("SubstageHierarchy")

  @@index([stageId])
  @@index([parentSubstageId])
  @@map("process_substages")
}